        "atlasnet-cartograph"
      ]
    },
    "atlasnet-db": {
      "context": ".",
      "dockerfile": "dev/docker/Production.Dockerfile",
      "target": "atlasnet-db",
      "load": true,
      "tags": [
        "atlasnet-db"
      ]
    }


  }
}