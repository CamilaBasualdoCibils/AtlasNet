{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Valkey",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/external/valkey/src/valkey-server",
            "args": [
                "--loadmodule",
                "./libAtlasNetDB.so"
            ],
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Valkey-Server + AtlasNetDB"
        },
        {
            "name": "CMake Test (GDB Fork)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "args": [
                "${cmake.testArgs}"
            ],
            "cwd": "${cmake.testWorkingDirectory}",
            "environment": "${cmake.testEnvironment}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "set follow-fork-mode parent"
                },
                {
                    "text": "set detach-on-fork off"
                },
                {
                    "text": "set schedule-multiple on"
                },
                {
                    "text": "set breakpoint pending on"
                }
            ],
            "presentation": {
                "hidden": true
            }
        }
    ]
}