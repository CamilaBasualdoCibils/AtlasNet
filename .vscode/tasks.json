{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Valkey-Server",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "Valkey-Server-Compile"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build AtlasNetNode-ValkeyModule",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "AtlasNetNode-ValkeyModule"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Valkey-Server + AtlasNetNode-ValkeyModule",
            "dependsOn": [
                "Build Valkey-Server",
                "Build AtlasNetNode-ValkeyModule"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}